# --- ค่าเหล่านี้ใช้สำหรับทดสอบบน localhost เท่านั้น ---
# ก่อนขึ้น production จริง ให้เปลี่ยนทุกค่าที่เป็นความลับ (token/password/secret)

# พอร์ตฝั่ง host ที่จะ publish API ออกมา (container ข้างในยังคงเป็น 8000 เสมอ)
API_PORT=3005

INFLUX_URL=http://innovation.ntplc.co.th:3002
INFLUX_ORG=<ชื่อ org หรือ orgID>
INFLUX_BUCKET=<ชื่อ bucket ที่สร้างไว้>
INFLUX_TOKEN=<admin token>

JWT_SECRET=local-dev-jwt-secret-please-change
DEVICE_API_KEY=local-dev-device-key
DEFAULT_ADMIN_PASSWORD=admin123

# Telegram bot สำหรับแจ้งเตือน - เอา token จาก BotFather มาใส่ตรงนี้
TELEGRAM_BOT_TOKEN=<วาง token ที่ได้จาก BotFather ตรงนี้>

# URL สาธารณะที่เปิดหน้าเว็บนี้ได้จากข้างนอก (ไม่ต้องมี / ปิดท้าย)
APP_PUBLIC_URL=http://localhost:3005